// Prisma schema for Key-Kingdom product + vendor storage
// SQLite is used by default for local development.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String       @id
  name        String
  slug        String       @unique
  // category field removed
  iconUrl     String
  heroImageUrl String?
  tagline     String?
  description String
  features    String
  sortOrder   Int?
  isUpdated   Boolean      @default(true)
  tags        String?
  lastUpdated String?
  vendorLinks VendorLink[]
}
model VendorLink {
  id             String   @id
  vendorName     String
  url            String
  redirectUrl    String?
  price          Float
  currency       String
  paymentMethods String
  notes          String?
  ctaLabel       String?
  avatarUrl      String?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}
