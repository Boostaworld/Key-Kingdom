# Required: SQLite dev database
DATABASE_URL="file:./dev.db"

# Required: admin credentials for the panel and API
ADMIN_USERNAME="change-me"
ADMIN_PASSWORD="change-me"

# Optional: webhook to receive audit logs for logins and mutations
ADMIN_AUDIT_WEBHOOK_URL=""

# Optional: bearer token + label for automation (Python/Discord bots)
ADMIN_API_TOKEN=""
ADMIN_API_ACTOR="automation"
